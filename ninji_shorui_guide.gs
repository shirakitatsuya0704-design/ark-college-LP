/**
 * 任意書類作成ガイド — Google Docs 生成スクリプト
 *
 * 使い方:
 *   1. https://script.google.com にアクセス
 *   2. 「新しいプロジェクト」を作成
 *   3. このコードを貼り付けて保存
 *   4. 「createNinjiShoruiGuide」を選択して「実行」
 *   5. Googleドライブのマイドライブに新しいドキュメントが作成されます
 */

function createNinjiShoruiGuide() {
  const doc = DocumentApp.create(
    '任意書類作成ガイド — 総合型選抜における「伝わる資料」の作り方'
  );
  const body = doc.getBody();
  body.clear();

  // ページ余白を設定（単位: ポイント。20mm ≈ 56.7pt）
  body.setMarginTop(56.7);
  body.setMarginBottom(56.7);
  body.setMarginLeft(63.0);
  body.setMarginRight(63.0);

  // ===== ヘルパー関数 =====

  function title(text) {
    const p = body.appendParagraph(text);
    p.setHeading(DocumentApp.ParagraphHeading.TITLE);
    p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    p.editAsText().setFontSize(20).setBold(true);
    return p;
  }

  function subtitle(text) {
    const p = body.appendParagraph(text);
    p.setHeading(DocumentApp.ParagraphHeading.SUBTITLE);
    p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    p.editAsText().setFontSize(12).setBold(false);
    return p;
  }

  function h1(text) {
    const p = body.appendParagraph(text);
    p.setHeading(DocumentApp.ParagraphHeading.HEADING1);
    p.editAsText().setFontSize(14).setBold(true);
    return p;
  }

  function h2(text) {
    const p = body.appendParagraph(text);
    p.setHeading(DocumentApp.ParagraphHeading.HEADING2);
    p.editAsText().setFontSize(12).setBold(true);
    return p;
  }

  function h3(text) {
    const p = body.appendParagraph(text);
    p.setHeading(DocumentApp.ParagraphHeading.HEADING3);
    p.editAsText().setFontSize(11).setBold(true);
    return p;
  }

  function body_p(text) {
    const p = body.appendParagraph(text);
    p.setHeading(DocumentApp.ParagraphHeading.NORMAL);
    p.setLineSpacing(1.6);
    p.setSpacingBefore(0);
    p.setSpacingAfter(6);
    p.editAsText().setFontSize(10.5);
    return p;
  }

  function bullet(text, level) {
    level = level || 0;
    const item = body.appendListItem(text);
    item.setNestingLevel(level);
    item.setGlyphType(DocumentApp.GlyphType.BULLET);
    item.setLineSpacing(1.5);
    item.editAsText().setFontSize(10.5);
    return item;
  }

  function spacer() {
    const p = body.appendParagraph('');
    p.setSpacingBefore(0);
    p.setSpacingAfter(0);
    return p;
  }

  function pageBreak() {
    body.appendPageBreak();
  }

  function sectionDivider() {
    spacer();
    const p = body.appendParagraph('────────────────────────────────────');
    p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    p.editAsText().setFontSize(8).setForegroundColor('#AAAAAA');
    spacer();
  }

  // 薄いグレー背景の例示ボックス
  function exampleBox(label, lines) {
    const content = label + '\n' + lines.join('\n');
    const table = body.appendTable([[content]]);
    table.setBorderWidth(0.75);
    const cell = table.getRow(0).getCell(0);
    cell.setBackgroundColor('#F3F4F6');
    cell.setPaddingTop(6);
    cell.setPaddingBottom(6);
    cell.setPaddingLeft(10);
    cell.setPaddingRight(10);
    const t = cell.editAsText();
    t.setFontSize(10);
    t.setForegroundColor('#333333');
    // ラベル部分を太字に（label の文字数分）
    t.setBold(0, label.length - 1, true);
    return table;
  }

  // 通常の表（ヘッダー行あり）
  function appendTable(headers, rows) {
    const tableData = [headers, ...rows];
    const table = body.appendTable(tableData);
    table.setBorderWidth(1);
    const headerRow = table.getRow(0);
    for (let c = 0; c < headers.length; c++) {
      const cell = headerRow.getCell(c);
      cell.setBackgroundColor('#E8F0FE');
      cell.editAsText().setBold(true).setFontSize(10);
    }
    for (let r = 1; r < tableData.length; r++) {
      const row = table.getRow(r);
      for (let c = 0; c < headers.length; c++) {
        const cell = row.getCell(c);
        cell.editAsText().setFontSize(10);
        cell.setPaddingTop(4);
        cell.setPaddingBottom(4);
        cell.setPaddingLeft(6);
        cell.setPaddingRight(6);
      }
    }
    return table;
  }

  // ===== 表紙 =====

  spacer();
  spacer();
  spacer();
  title('任意書類作成ガイド');
  spacer();
  subtitle('総合型選抜における「伝わる資料」の作り方');
  spacer();
  spacer();

  const coverNote = body.appendParagraph(
    '本ガイドは、総合型選抜（AO入試）の出願にあたり、\n' +
    '任意書類を自分で作成しようとするすべての受験生を対象としています。\n\n' +
    '資料の目的・構成・デザインの基本原則を体系的に学ぶことで、\n' +
    '審査員に「伝わる資料」を作るための実践的な指針を提供します。'
  );
  coverNote.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  coverNote.editAsText().setFontSize(10.5).setForegroundColor('#444444');
  coverNote.setLineSpacing(1.8);

  spacer();
  spacer();

  h2('目次');
  const tocItems = [
    '第1章　任意書類とは何か',
    '第2章　資料作成の基本原則（デザイン編）',
    '第3章　アンケート・調査レポートの作り方',
    '第4章　インタビュー書き起こしの作り方',
    '第5章　ポートフォリオ（活動実績集）の作り方',
    '第6章　その他の書類と提出前チェックリスト',
  ];
  tocItems.forEach(function(item) { body_p('　' + item); });

  pageBreak();

  // ===== 第1章 =====

  h1('第1章　任意書類とは何か');
  spacer();

  h2('1-1　定義と役割');
  body_p(
    '総合型選抜（旧AO入試）において、出願に必要な書類は大きく「必須書類」と「任意書類」の2種類に分けられます。' +
    '志望理由書や調査書といった必須書類が出願の前提条件であるのに対し、任意書類は受験生が自らの意思で追加提出できる補足資料です。'
  );
  body_p(
    '任意とはいえ、その影響は決して小さくありません。必須書類では書き切れなかった活動実績・研究成果・作品などを可視化できる' +
    '唯一の手段であり、大学によっては合否の重要な判断材料になります。特に慶應義塾大学SFC（湘南藤沢キャンパス）では' +
    '最大10点の任意書類提出が認められており、書類選考の評価に直結します。'
  );
  body_p(
    '本ガイドで最も重要なポイントは、「任意書類は志望理由書の証拠である」という考え方です。提出する書類は、' +
    '志望理由書で述べた活動・研究・問題意識を裏付けるものを選ぶことで、審査員に強い一貫性が伝わります。'
  );
  spacer();
  exampleBox(
    '【考え方の例】',
    [
      '志望理由書で「地域の食品ロス問題に取り組んできた」と書いた場合',
      '→ 任意書類として提出すべきもの：',
      '　・実際に行ったアンケート調査のレポート（第3章）',
      '　・食品ロスに詳しい専門家へのインタビュー書き起こし（第4章）',
      '　・活動の過程をまとめたポートフォリオ（第5章）',
      '',
      '志望理由書と任意書類が同じテーマで貫かれていると、説得力が格段に増します。',
    ]
  );
  spacer();

  h2('1-2　審査員が任意書類から読み取るもの');
  body_p('大学の審査員は、任意書類を通じて主に次の3点を確認しています。');
  spacer();

  h3('① アドミッションポリシーとの一致');
  body_p(
    '志望大学・学部が求める人物像に相応しいかどうかを判断します。単に優れた実績を持つ学生ではなく、' +
    'その大学で学ぶことに必然性がある学生を求めています。大学の募集要項やアドミッションポリシーを熟読し、' +
    '自分の書類との接点を明確にすることが求められます。'
  );

  h3('② 探究の深さと思考力');
  body_p(
    '活動の種類や規模ではなく、その活動を通じて何を考え、何を学んだかが問われます。' +
    '表面的な成果の列挙ではなく、問題意識の深さと論理的な思考の跡が評価対象です。' +
    '「大変だった」「頑張った」という感想ではなく、「なぜそうなったのか」「何が課題だったのか」' +
    'という分析の視点を持つことが重要です。'
  );

  h3('③ 表現・構成・論理性');
  body_p(
    '内容が整理されており、第三者が読んで理解できる構成かどうかを見ています。' +
    'どれほど優れた内容でも、読みにくい・構成が不明瞭な書類は評価が下がります。' +
    '本ガイドで学ぶデザインと構成の原則は、この点を向上させるためのものです。'
  );
  spacer();

  h2('1-3　主な任意書類の種類');
  body_p(
    '以下に、総合型選抜で提出されることが多い任意書類の種類をまとめます。' +
    '自分の活動実績と志望理由書の内容を照らし合わせて、最も効果的な種類を選びましょう。'
  );
  spacer();

  appendTable(
    ['種類', '概要', '向いている場面'],
    [
      ['アンケート・調査レポート', '独自調査の内容・結果・考察をまとめた資料', '研究活動や社会課題への取り組みを示したい場合'],
      ['インタビュー書き起こし', '専門家・当事者へのインタビュー内容を整理した資料', '一次情報の収集力・調査力をアピールしたい場合'],
      ['ポートフォリオ（活動実績集）', '高校生活の活動・成果を体系的にまとめた資料', '幅広い活動実績を総合的に伝えたい場合'],
      ['活動報告書', '特定の活動・プロジェクトの詳細な記録', '一つの取り組みを深く掘り下げて伝えたい場合'],
      ['提言書・提案書', '社会課題に対する自分なりの解決策・提言をまとめた資料', '問題解決能力や将来ビジョンを伝えたい場合'],
    ]
  );

  pageBreak();

  // ===== 第2章 =====

  h1('第2章　資料作成の基本原則（デザイン編）');
  spacer();
  body_p(
    '任意書類は内容の質が最優先ですが、読みやすく整ったデザインは内容の伝わりやすさを大きく左右します。' +
    '以下の原則を守ることで、審査員が内容に集中できる資料に仕上がります。'
  );
  spacer();

  h2('2-1　フォントの選び方');
  body_p('フォント選びは、資料全体の信頼性と読みやすさを決める基本要素です。');
  spacer();

  h3('本文フォントの原則');
  bullet('日本語本文：レポート・論文系の資料であれば明朝体、スライド・プレゼン系であればゴシック体（Noto Sans JPなど）を選びます。');
  bullet('英数字：日本語フォントと調和するものを使います。');
  bullet('フォントサイズ：本文は10〜11pt、中見出しは12pt、大見出しは14ptを目安にします。');
  bullet('資料全体でフォントの種類は2〜3種類に抑えましょう。');
  spacer();
  exampleBox(
    '【フォントの組み合わせ例】',
    [
      '◎ 推奨（レポート系）：游明朝（本文）＋ 游ゴシック（見出し）',
      '◎ 推奨（スライド系）：Noto Sans JP（本文・見出し、太さで区別）',
      '◎ 推奨（英数字）  ：Arial / Times New Roman（日本語フォントに合わせて選択）',
      '',
      '✕ 避けるべき例     ：HGP行書体、メイリオ＋游明朝＋ゴシックを混在、',
      '　　　　　　　　　  Comic Sansなど装飾フォント',
    ]
  );
  spacer();

  h3('避けるべきフォント');
  bullet('手書き風・毛筆体などの装飾的フォントは読みにくく、資料の信頼性を損ないます。');
  bullet('フォントを多用すると資料が散漫な印象になるため注意しましょう。');
  spacer();

  h2('2-2　余白とレイアウト');
  body_p('余白は「デザインの一部」です。適切な余白を確保することで、資料は格段に読みやすくなります。');
  spacer();

  h3('余白の基準');
  bullet('上下左右の余白：最低20mm以上（A4の場合）を確保します。');
  bullet('段落間の空白：段落と段落の間に適度なスペースを設けます（密集した印象を避けます）。');
  bullet('行間：1.5〜1.8倍に設定します。');
  spacer();
  exampleBox(
    '【余白・行間の設定例（Google Docs / Word）】',
    [
      '上下余白：25mm　左右余白：20mm',
      '行間：1.5倍（「書式」→「行間とパラグラフの間隔」→「1.5」）',
      '',
      '余白が狭すぎる資料は「詰め込み感」が出て、審査員が読む気を失います。',
      'ページ数が増えても、余白を削って詰め込もうとするのはNGです。',
    ]
  );
  spacer();

  h3('レイアウトの原則');
  bullet('1ページに詰め込みすぎません。情報密度は「余裕がある」と感じる程度にとどめます。');
  bullet('原則として1段組みを使用し、必要な場合のみ2段組みを採用します。');
  bullet('写真・図表は関連する本文の近くに配置し、図表のタイトルを必ず付記します。');
  spacer();

  h2('2-3　色の使い方');
  body_p('色を多用しすぎると資料が読みにくくなります。以下の原則を守ることで、洗練された印象を与えられます。');
  spacer();

  h3('色数の制限');
  bullet('使用する色は原則3色以内（メインカラー1色＋アクセントカラー1色＋モノクロ）に抑えます。');
  bullet('背景は白、本文は黒（または濃いグレー）を基本とします。');
  spacer();
  exampleBox(
    '【配色例】',
    [
      '◎ 落ち着いた印象のパターン',
      '　 メインカラー（見出し）：紺 #1A3C6E',
      '　 アクセント（強調語句）：テキスト太字のみ（色なし）',
      '　 本文テキスト          ：濃いグレー #333333',
      '',
      '◎ 清潔感のあるパターン',
      '　 メインカラー（見出し）：ディープグリーン #2E5B3A',
      '　 アクセント（重要箇所）：下線のみ',
      '　 本文テキスト          ：黒 #1A1A1A',
      '',
      '✕ NGパターン：見出しが赤、本文の一部がオレンジ、強調が黄色マーカー',
      '　（色が多すぎてどこが重要か分からなくなります）',
    ]
  );
  spacer();

  h3('効果的な色の使い方');
  bullet('見出しや重要キーワードに統一したアクセントカラー（1色）を使います。');
  bullet('赤・オレンジ・黄色を多用すると読みにくくなります。落ち着いた色調（紺・深緑・グレーなど）を選びましょう。');
  bullet('白黒印刷でも情報が正確に伝わるデザインを意識します。');
  spacer();

  h2('2-4　情報の階層化');
  body_p(
    '情報を「大→中→小」の階層で整理することで、読み手は資料の構造を即座に把握できます。' +
    'この原則はすべての種類の任意書類に共通して適用されます。'
  );
  spacer();

  h3('見出しの使い方');
  bullet('大見出し（章タイトル）：最も大きいフォントサイズ、太字。');
  bullet('中見出し（節タイトル）：中程度のサイズ、太字またはアンダーライン。');
  bullet('本文：統一されたサイズと書体。');
  spacer();
  exampleBox(
    '【階層構造の例】',
    [
      '■ 第3章　アンケート・調査レポートの作り方　← 大見出し（14pt・太字）',
      '  ▶ 3-1　調査の背景と目的　← 中見出し（12pt・太字）',
      '      3-1-1　問いを立てた経緯　← 小見出し（11pt・太字）',
      '          本文テキスト（10.5pt）が続きます。',
      '',
      '階層が視覚的に明確だと、審査員は「今この資料のどこを読んでいるか」を',
      '常に把握しながら読み進められます。',
    ]
  );
  spacer();

  h3('箇条書きと文章の使い分け');
  bullet('列挙できる情報は箇条書きにします。ただし、箇条書きにしすぎると論理のつながりが失われるため注意が必要です。');
  bullet('説明・分析・考察が必要な箇所は、文章（パラグラフ）で丁寧に書きましょう。');
  spacer();

  h3('図・表・グラフの活用');
  bullet('データや比較情報は表やグラフで示す方が伝わりやすいです。');
  bullet('図表には必ずタイトルと出典（必要な場合）を付記します。');
  bullet('グラフは内容に合った種類を選びます（割合→円グラフ、比較→棒グラフ、推移→折れ線グラフ）。');
  spacer();
  exampleBox(
    '【グラフ選択の例】',
    [
      'アンケートで「スマホを1日何時間使うか」を聞いた場合',
      '',
      '→ 「1時間未満・1〜2時間・2〜3時間・3時間以上」の割合を示したい',
      '   ▶ 円グラフ　または　積み上げ棒グラフ（割合の比較）',
      '',
      '→ 「学年別に平均利用時間を比べたい」',
      '   ▶ 棒グラフ（カテゴリ間の比較）',
      '',
      '→ 「3ヶ月で利用時間がどう変化したか」',
      '   ▶ 折れ線グラフ（時系列の推移）',
    ]
  );

  pageBreak();

  // ===== 第3章 =====

  h1('第3章　アンケート・調査レポートの作り方');
  spacer();

  h2('3-1　この書類が果たす役割');
  body_p(
    'アンケートや調査レポートは、受験生が特定の社会課題・テーマに対して自ら調査を行い、' +
    'その結果と考察をまとめた資料です。この書類を提出することで次の点をアピールできます。'
  );
  bullet('問題意識の具体性：漠然とした関心ではなく、明確な問いを立てて取り組んでいること。');
  bullet('調査・情報収集能力：アンケートの設計・配布・集計を自ら行う行動力。');
  bullet('分析・思考力：データや意見から意味を読み取り、自分の考えを導く能力。');
  spacer();

  h2('3-2　推奨構成');

  h3('① 表紙（1ページ目）');
  bullet('タイトル：調査テーマを端的に示します。');
  bullet('実施日・実施者名・調査の概要（2〜3文）。');
  spacer();
  exampleBox(
    '【タイトルの例】',
    [
      '◎ 良い例：「高校生のスマートフォン利用時間と学習集中度に関するアンケート調査',
      '　　　　　 （実施期間：2024年9月／対象：○○高校2年生82名）」',
      '',
      '✕ 悪い例：「スマホについてのアンケート」',
      '　（何を、誰に、いつ調査したかが不明で信頼性に欠けます）',
    ]
  );
  spacer();

  h3('② 調査の背景・目的');
  bullet('なぜこのテーマに着目したかを、具体的なエピソードを交えて説明します。');
  bullet('「問い（リサーチクエスチョン）」を明文化します。');
  spacer();
  exampleBox(
    '【リサーチクエスチョンの例】',
    [
      '◎ 明確な問いの例：',
      '  「スマートフォンの1日あたり利用時間が長い生徒ほど、',
      '   自己評価による学習集中度が低い傾向があるか」',
