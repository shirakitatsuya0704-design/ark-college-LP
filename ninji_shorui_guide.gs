  // ===== 第5章 =====

  h1('第5章　ポートフォリオ（活動実績集）の作り方');
  spacer();

  h2('5-1　この書類が果たす役割');
  body_p(
    'ポートフォリオとは、高校生活を通じて取り組んできた活動・実績・作品などを体系的にまとめた資料です。' +
    '「自分という人間を伝えるための名刺」と捉えるとわかりやすいでしょう。この書類を提出することで次の点をアピールできます。'
  );
  bullet('活動の幅と深さ：高校3年間でどのような経験を積んできたか。');
  bullet('成長の軌跡：時間軸に沿って自分がどのように変化・成長してきたか。');
  bullet('テーマの一貫性：活動全体を貫くテーマや問題意識があるかどうか。');
  spacer();

  h2('5-2　推奨構成');

  h3('① 表紙');
  bullet('氏名・学校名・志望学部。');
  bullet('（任意）キャッチコピー：テーマの一貫性が伝わるフレーズがあると効果的です。');
  spacer();
  exampleBox(
    '【キャッチコピーの例】',
    [
      '「問いを立て、動き続けた3年間 ── 食と地域をつなぐ探究の記録」',
      '「データで社会を読み解く。高校3年間の実践と学び」',
      '「演劇と福祉の接点を探して ── 表現で誰かの世界を広げるために」',
      '',
      'キャッチコピーは「どんな人間か」が一言で伝わるものを目指します。',
      '思いつかない場合は省略しても構いません。',
    ]
  );
  spacer();

  h3('② 目次');
  bullet('ページ数が8ページ以上になる場合は必ず設けます。');
  spacer();

  h3('③ 自己紹介・テーマ紹介（1ページ）');
  bullet('自分のコアテーマ（どのような問題意識を持って活動してきたか）を簡潔に述べます。');
  spacer();

  h3('④ 活動記録（各活動1〜2ページ）');
  body_p('各活動について以下の4要素（What / Why / How / Result & Learning）を必ず記述します。');
  bullet('What（何をしたか）：活動の概要を客観的に記述する。');
  bullet('Why（なぜしたか）：動機・問題意識を説明する。');
  bullet('How（どのように取り組んだか）：プロセス・工夫・困難と乗り越え方を記述する。');
  bullet('Result & Learning（結果と学び）：成果を定量・定性の両面で示し、得た学びを述べる。');
  spacer();
  exampleBox(
    '【活動記録の記述例　NG → OK】',
    [
      '✕ NGの書き方：',
      '「ボランティア活動をしました。大変でしたが、やりがいを感じました。」',
      '（何をしたか・なぜしたか・どう取り組んだか・何を学んだかが一切不明）',
      '',
      '◎ OKの書き方（What / Why / How / Result の構成）：',
      '【What】2024年8月、地域の農家5軒と協力し、規格外野菜の販売イベントを',
      '　　　　2日間にわたって開催しました（来場者数：延べ230名）。',
      '',
      '【Why】地域の農家が規格外品の廃棄に悩んでいると知り、',
      '　　　食品ロスと農業の両面から課題を解決できないかと考えたためです。',
      '',
      '【How】①農家へのヒアリングで出品可能な野菜を把握し、②SNSで告知を行い、',
      '　　　③当日は説明ポップを手作りしてお客様が手に取りやすい環境を作りました。',
      '　　　準備段階では農家との意見の食い違いが生じましたが、',
      '　　　週1回の話し合いを設けることで合意形成を進めました。',
      '',
      '【Result & Learning】売上の90%を規格外品が占め、農家からは「廃棄量が半分になった」',
      '　　　との声をいただきました。この経験を通じて、課題解決には当事者との継続的な対話が',
      '　　　不可欠であることを学びました。この視点は、大学での政策立案研究でも活かしたいです。',
    ]
  );
  spacer();

  h3('⑤ 総括（1ページ）');
  bullet('3年間の活動を振り返り、一貫するテーマや自分の成長を総括します。');
  bullet('大学入学後にどう発展させるかを述べて締めくくります。');
  spacer();

  h2('5-3　記述のポイント');
  bullet('「〇〇部に所属していました」という事実の列挙ではなく、「そこで何を考え、何を学んだか」まで書きます。');
  bullet('数値で示せる成果は積極的に使います（例：「部員30名のリーダーとして」「200名に配布したアンケートで」）。');
  bullet('困難や失敗、それをどう乗り越えたかを書くと、思考の深さが伝わります。');
  bullet('最も重要な活動（志望理由書と関連する活動）に多くのページを割きます。全活動を同じ分量にする必要はありません。');
  spacer();

  h2('5-4　デザインの注意点');
  bullet('写真を積極的に活用します（活動の様子・成果物・受賞証書など）。ただし写真とテキストのバランスを保ちます。');
  bullet('各活動に統一されたレイアウトテンプレートを使うことで、読み手は迷わず情報を把握できます。');
  bullet('全体のトーン（色・フォント・デザイン）を統一し、一つの作品集として完結した印象を与えます。');
  bullet('時系列（1年生→2年生→3年生）かテーマ別（活動種別ごと）に整理します。時系列は成長の軌跡、テーマ別はテーマの一貫性を強調しやすいです。');
  spacer();
  exampleBox(
    '【ページレイアウトのイメージ（活動記録1ページの構成例）】',
    [
      '┌──────────────────────────────────┐',
      '│ 【活動タイトル】規格外野菜販売イベントの企画・運営       │',
      '│ 期間：2024年7月〜8月　　　　　　　　　　　　　　　　　  │',
      '├──────────────────────────────────┤',
      '│ [写真・図]                │ What：〜しました。          │',
      '│                           │ Why ：〜だったためです。    │',
      '│ ← イベントの写真や        │ How ：〜ました。            │',
      '│    チラシなどを配置        │ Result：〜となりました。    │',
      '│                           │ Learning：〜を学びました。  │',
      '└──────────────────────────────────┘',
      '',
      '写真1枚 + What/Why/How/Result の文章で1ページを構成すると',
      'バランスよく読みやすくなります。',
    ]
  );
  spacer();

  h2('5-5　よくある失敗と対策');
  spacer();
  appendTable(
    ['よくある失敗', '対策'],
    [
      ['全活動を同じ分量で掲載している', '志望理由と関連する活動に多くのページを割く'],
      ['「頑張った」「大変だった」という主観表現のみ', '具体的な行動・数値・結果を客観的に記述する'],
      ['デザインがページごとにバラバラ', 'テンプレートを作り、全ページで統一する'],
      ['写真の質が低い（ぼけている・暗い）', '高解像度の写真を使い、掲載前に確認する'],
      ['総括がなく突然終わる', '3年間を振り返るまとめのページを必ず設ける'],
    ]
  );

  pageBreak();

  // ===== 第6章 =====

  h1('第6章　その他の書類と提出前チェックリスト');
  spacer();

  h2('6-1　活動報告書');
  body_p(
    '活動報告書は、ポートフォリオと異なり、特定の一つの活動・プロジェクトに絞って詳細を報告する書類です。' +
    'ポートフォリオが「幅の広さ」を示すのに対し、活動報告書は「深さ」を示します。'
  );

  h3('推奨構成');
  bullet('① 活動概要（タイトル・期間・参加規模）');
  bullet('② 取り組みの背景・目的');
  bullet('③ 活動の詳細（プロセス・自分の役割・工夫）');
  bullet('④ 成果・結果（定量的・定性的の両面）');
  bullet('⑤ 反省・課題');
  bullet('⑥ この活動から得た学びと、大学での展開');
  spacer();

  h2('6-2　提言書・提案書');
  body_p(
    '提言書・提案書は、受験生が設定した社会課題に対して、具体的な解決策・政策提言・行動計画などを論述する書類です。' +
    '問題解決能力と将来ビジョンを明確に示したい受験生に適しています。'
  );

  h3('推奨構成');
  bullet('① 問題提起（解決しようとする課題の定義）');
  bullet('② 現状分析（データ・事例に基づいた現状把握）');
  bullet('③ 課題の根本原因');
  bullet('④ 提言内容（具体的な解決策）');
  bullet('⑤ 実現可能性と想定される課題');
  bullet('⑥ まとめと自分のビジョン');
  spacer();

  h2('6-3　提出前チェックリスト');
  body_p('以下のすべての項目を確認してから提出しましょう。');
  spacer();

  h3('【内容の確認】');
  bullet('□ 志望理由書と任意書類の内容に一貫性があるか');
  bullet('□ 抽象的な表現ではなく、具体的な事実・データが示されているか');
  bullet('□ 考察・分析のセクションで自分の意見が明確に述べられているか');
  bullet('□ 誤字脱字はないか（印刷して紙で確認することを推奨します）');
  spacer();

  h3('【デザインの確認】');
  bullet('□ フォントと文字サイズが全ページで統一されているか');
  bullet('□ 余白は十分に確保されているか（上下左右20mm以上）');
  bullet('□ 使用色は3色以内に収まっているか');
  bullet('□ すべての図表・グラフにタイトルが付いているか');
  spacer();

  h3('【形式の確認】');
  bullet('□ 大学が指定するページ数・ファイル形式を守っているか');
  bullet('□ ファイル名は指定されたルールに従っているか');
  bullet('□ 提出期限に十分な余裕を持って完成しているか');
  spacer();

  sectionDivider();

  const closing = body.appendParagraph(
    '任意書類は「見てもらえるかどうかわからない資料」ではなく、\n' +
    '自分の探究を審査員に伝えるための重要な機会です。\n' +
    '本ガイドを参考に、自分の言葉で、自分の実績を誠実に伝える資料を作り上げてください。'
  );
  closing.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  closing.editAsText().setFontSize(10.5).setForegroundColor('#444444').setItalic(true);
  closing.setLineSpacing(1.8);

  doc.saveAndClose();

  const url = doc.getUrl();
  Logger.log('ドキュメントが作成されました: ' + url);

  return url;
}
